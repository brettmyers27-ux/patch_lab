#!/bin/sh
# Replace only an existing PatchLab.app. Never touch user data in ~/Library.
set -eu

TARGET_VOLUME="$3"
TARGET="${TARGET_VOLUME%/}/Applications/PatchLab.app"

if [ ! -e "$TARGET" ]; then
    exit 0
fi

if [ -x "$TARGET/Contents/MacOS/PatchLab" ] && pgrep -f "$TARGET/Contents/MacOS/PatchLab" >/dev/null 2>&1; then
    echo "Quit PatchLab before installing this update." >&2
    exit 1
fi

BUNDLE_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$TARGET/Contents/Info.plist" 2>/dev/null || true)"
if [ "$BUNDLE_ID" != "com.patchlab.desktop" ]; then
    echo "Refusing to replace an unexpected application at $TARGET." >&2
    exit 1
fi

rm -rf "$TARGET"
